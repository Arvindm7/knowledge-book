# =============================================================================
# Knowledge Book — Environment Variables
# =============================================================================
# Copy this file to `.env.local` and fill in the values.
# Variables prefixed with NEXT_PUBLIC_ are exposed to the browser.
# =============================================================================

# ---------- Site ----------
# Base URL where the site is deployed (no trailing slash).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------- Content Source ----------
# GitHub repository slug for the knowledge-base (e.g., "username/knowledge-base").
NEXT_PUBLIC_KNOWLEDGE_BASE_REPO=
KNOWLEDGE_BASE_REPO=

# Branch to fetch content from (default: main).
KNOWLEDGE_BASE_BRANCH=main

# ---------- GitHub API ----------
# Personal Access Token for GitHub API requests.
# Required to avoid rate limiting (60 req/hr unauthenticated → 5000 req/hr authenticated).
# Create one at: https://github.com/settings/tokens
# Scopes needed: `repo` (for private repos) or no scopes (for public repos).
GITHUB_TOKEN=

# ---------- Build Pipeline ----------
# Path to the local content directory (default: .content/knowledge-base).
# Set this only if you've manually cloned the knowledge-base elsewhere.
# CONTENT_DIR=

# ---------- Vercel Deployment (CI only) ----------
# These are used by GitHub Actions for deployment.
# Get from: https://vercel.com/account/tokens
# VERCEL_TOKEN=
# VERCEL_ORG_ID=
# VERCEL_PROJECT_ID=

# ---------- Analytics ----------
# Google Analytics 4 measurement ID (e.g., "G-XXXXXXXXXX").
NEXT_PUBLIC_GA_ID=
